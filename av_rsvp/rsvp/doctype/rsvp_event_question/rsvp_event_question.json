{
 "doctype": "DocType",
 "name": "RSVP Event Question",
 "module": "RSVP",
 "engine": "InnoDB",
 "autoname": "hash",
 "istable": 1,
 "field_order": [
  "question_key",
  "question_label",
  "question_type",
  "options"
 ],
 "fields": [
  {
   "fieldname": "question_key",
   "label": "Question Key",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "question_label",
   "label": "Question",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "question_type",
   "label": "Answer Type",
   "fieldtype": "Select",
   "options": "Text\nLong Text\nSelect\nCheck",
   "default": "Text",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "options",
   "label": "Choices",
   "fieldtype": "Small Text",
   "depends_on": "eval:doc.question_type === \"Select\"",
   "description": "One choice per line for Select questions."
  }
 ],
 "permissions": []
}
